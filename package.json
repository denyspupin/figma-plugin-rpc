{
	"name": "figma-plugin-rpc",
	"version": "0.1.0",
	"description": "Type-safe RPC for Figma plugins — request/response procedures and server→client notifications over postMessage, with built-in Figma transports.",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"prepublishOnly": "npm run build"
	},
	"keywords": [
		"figma",
		"figma-plugin",
		"rpc",
		"postmessage",
		"iframe",
		"type-safe",
		"typescript"
	],
	"author": "Denys Pupin",
	"license": "MIT",
	"peerDependencies": {
		"@figma/plugin-typings": ">=1.0.0"
	},
	"peerDependenciesMeta": {
		"@figma/plugin-typings": {
			"optional": true
		}
	},
	"dependencies": {
		"nanoid": "^5.1.6"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.4.0",
		"@commitlint/config-conventional": "^20.4.0",
		"@eslint/js": "^10.0.1",
		"@figma/plugin-typings": "^1.132.0",
		"@typescript-eslint/parser": "^8.65.0",
		"eslint": "^10.8.0",
		"husky": "^9.1.7",
		"jsdom": "30.0.1",
		"prettier": "^3.9.6",
		"tsup": "^8.4.0",
		"typescript": "~5.6.2",
		"typescript-eslint": "^8.65.0",
		"vitest": "^4.0.0"
	}
}
